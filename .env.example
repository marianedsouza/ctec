# Conexão com o PostgreSQL usada pelo Prisma.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wiki_ses_ms?schema=public"

# Segredo usado pelo NextAuth (Auth.js) para assinar sessões/tokens JWT.
# Gere um valor com: npx auth secret  (ou openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-forte-em-producao"
